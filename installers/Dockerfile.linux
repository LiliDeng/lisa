FROM mcr.microsoft.com/azurelinux/base/core:3.0

ARG PYTHON_VERSION=stable

WORKDIR /app

RUN tdnf update -y && \
    tdnf install -y \
        bzip2-devel \
        build-essential \
        ca-certificates \
        curl \
        git \
        gcc \
        gdbm-devel \
        gobject-introspection-devel \
        cairo-gobject \
        cairo-devel \
        libffi-devel \
        libuuid-devel \
        libvirt-devel \
        make \
        ncurses-devel \
        openssl-devel \
        pkg-config \
        readline-devel \
        sqlite-devel \
        tar \
        wget \
        xz \
        xz-devel \
        zlib-devel \
        cairo-gobject-devel && \
    tdnf clean all && \
    rm -rf /var/cache/tdnf /tmp/*

RUN wget "https://aka.ms/lisa-python" -O "Python-${PYTHON_VERSION}.tar.xz" && \
    tar -xJf "Python-${PYTHON_VERSION}.tar.xz" && \
    PYTHON_SOURCE_DIR="$(find /app -maxdepth 1 -type d -name 'Python-*' -print -quit)" && \
    test -n "${PYTHON_SOURCE_DIR}" && \
    cd "${PYTHON_SOURCE_DIR}" && \
    ./configure --prefix=/opt/python --enable-optimizations --with-ensurepip=install && \
    make -j "$(nproc)" && \
    PYTHON_RELEASE_VERSION="$(./python -c 'import sys; print(".".join(map(str, sys.version_info[:3])))')" && \
    make altinstall && \
    ln -sf "/opt/python/bin/python${PYTHON_RELEASE_VERSION%.*}" /usr/local/bin/python3 && \
    ln -sf "/opt/python/bin/pip${PYTHON_RELEASE_VERSION%.*}" /usr/local/bin/pip3 && \
    python3 --version | grep -Fx "Python ${PYTHON_RELEASE_VERSION}" && \
    cd /app && \
    rm -rf "${PYTHON_SOURCE_DIR}" "Python-${PYTHON_VERSION}.tar.xz"

ENV PATH="/opt/python/bin:${PATH}"

RUN wget https://aka.ms/downloadazcopy-v10-linux -O azcopy.tar.gz && \
    tar -xvf azcopy.tar.gz && \
    mv azcopy*/azcopy /usr/local/bin/ && \
    rm -rf azcopy*

ENV LISA_azcopy_path="/usr/local/bin/azcopy"

RUN git clone --depth 1 --branch feature/docker-python-3.14.7 \
    https://github.com/microsoft/lisa.git /app/lisa

WORKDIR /app/lisa

RUN python3 -m pip install --no-cache-dir --upgrade pip || true && \
    python3 -m pip install --no-cache-dir --editable .[ado,azure,libvirt,baremetal] --config-settings editable_mode=compat
